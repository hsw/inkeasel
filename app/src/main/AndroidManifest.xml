<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- BLE is the app's only transport; Bluetooth is not on the TV-MT list of features TVs may lack -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true"
        tools:ignore="UnsupportedTvHardware" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android <= 11: BLE scanning needs the legacy Bluetooth permissions plus fine location -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <!-- Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- UploadService: manual uploads and shares run in it, so playback in another app is not interrupted;
         automatic (now-playing) uploads run in the process and use it only to hold the process while the
         notification listener is not bound -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- The system screens the settings open (package visibility, Android 11+): notification access for the
         now-playing poster (the app's own page, else the list; on Android TV without them, Settings → Apps or
         the Settings home, ListenerAccess), and App info for permissions. -->
    <queries>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <!-- No backup and no device-to-device transfer of the app's data (PRIVACY.md): allowBackup for Android 11
         and older, the data extraction rules for 12+ (no fullBackupContent needed with backup off).
         No cleartext traffic on any version (PRIVACY.md: https only): targetSdk 28+ makes that the default only
         from Android 9, so Android 8.x needs it said; it also makes OkHttp refuse a redirect to http://. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkEasel"
        tools:ignore="DataExtractionRules">
        <!-- Any orientation. Rotation and resizing do not recreate the activity (no second permission prompt;
             the settings scan and the focus survive): the UI is all Compose and re-lays out for the width. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Share → InkEasel" from a gallery or a file manager: copies the picture into "My pictures" and sends it
             (ShareActivity). Invisible, no history, not in the recents. An empty task affinity: it runs in a task of
             its own (or the sender's), never in the app's task, which a later share would only bring to the front
             without delivering the new picture; MainActivity, when opened, goes to the app's own task. -->
        <activity
            android:name=".ShareActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.InkEasel.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Transient foreground service: a manual upload (or a hold for automatic ones), then it stops itself.
             Not exported: another app must not make it upload a picture of its choosing to the user's frame. The
             debug build exports it for the adb trigger (src/debug/AndroidManifest.xml). -->
        <service
            android:name=".UploadService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Reads MediaSession metadata of any app (now playing → poster on the frame). Bound by the system
             once granted: adb shell cmd notification allow_listener io.github.hsw.inkeasel/io.github.hsw.inkeasel.nowplaying.NowPlayingListener -->
        <service
            android:name=".nowplaying.NowPlayingListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
