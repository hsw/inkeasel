<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of the app's data goes into a cloud backup or a device-to-device transfer
     (android:allowBackup="false" covers Android 11 and older, and only the cloud backup on 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
